# ⛩️ SUKUNA BOT v4 — Environment Variables

# رقمك بدون + أو مسافات (مطلوب)
PAIRING_NUMBER=

# أرقام المطورين — مفصولة بفاصلة
OWNER_NUMBERS=201036547166

# اسم البوت
BOT_NAME=⛩️SUKUNA BOT

# البادئة
PREFIX=.

# وضع عام (true) أو مطور فقط (false)
PUBLIC_MODE=true

# رفض المكالمات تلقائياً
ANTI_CALL=true

# قراءة تلقائية
AUTO_READ=true

# تفاعل تلقائي مع رسائل المطور
AUTO_REACT=false

# اسم حزمة الملصقات
STICKER_PACK=⛩️ SUKUNA BOT
STICKER_AUTHOR=SUKUNA BOT

# Session ID (اختياري — base64 من creds.json)
SESSION_ID=
